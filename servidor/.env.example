# Copia este archivo como .env  (el .env NO se sube a git)
PORT=3000

# BASE_URL y FRONTEND_URL son OPCIONALES. Si no las pones, el servidor usa la dirección
# con la que se abrió el sitio (funciona aunque cambie la IP). Úsalas solo si necesitas fijarlas.
# BASE_URL=https://tudominio.cl
# FRONTEND_URL=https://tudominio.cl

# Orígenes permitidos por CORS (solo si el sitio está en otro dominio, ej. GitHub Pages). Separados por coma.
FRONTEND_ORIGIN=

# integracion (pruebas, credenciales públicas de Transbank) | produccion
TBK_AMBIENTE=integracion
# Solo para producción (te los entrega Transbank al aprobar tu comercio)
TBK_COMMERCE_CODE=
TBK_API_KEY=

# Comprobante de pago por correo al cliente (SMTP).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación" (no tu clave normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Aviso a la cervecería de cada pedido pagado (opcional; por defecto el Formspree que ya usaba el sitio)
# FORMSPREE_URL=https://formspree.io/f/xxxxxxx
